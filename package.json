{
  "name": "debate-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc -b && vp build",
    "preview": "vp build && wrangler dev",
    "prepare": "vp config",
    "deploy": "vp run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false",
    "gauntlet": "playwright test --config tests/gauntlet/playwright.config.ts --trace off"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/vue": "0.1.0-beta.17",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.168.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.28.0",
      "onFail": "download"
    }
  }
}
